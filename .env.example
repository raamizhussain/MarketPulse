# =========================================================
# MarketPulse AI — Production Environment Configuration (.env)
# =========================================================

# Application
PROJECT_NAME="MarketPulse AI"
ENVIRONMENT=production

# Security: Generate a 64-character random string (e.g. `openssl rand -hex 32`)
SECRET_KEY=your_secure_jwt_secret_key_here

# Primary Database (PostgreSQL / Supabase / AWS RDS / SQLite)
# Example Supabase: postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./marketpulse.db

# LLM & Market Inference Keys
GROQ_API_KEY=your_groq_api_key_here
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Distributed Caching (Optional Redis)
REDIS_URL=redis://localhost:6379/0

# Cloud Backups (Optional AWS S3)
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
